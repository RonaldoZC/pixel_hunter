# Copie para .env.local (ignorado pelo git) e reinicie o Expo. Nunca coloque segredos aqui:
# variáveis EXPO_PUBLIC_* ficam visíveis dentro do app.

# URL base da API: o gateway do back-end (porta 8080 por padrão), sem barra no final.
# - Celular com Expo Go: use o IP do computador na rede Wi-Fi, ex.: http://192.168.0.10:8080
# - Emulador Android: o computador é http://10.0.2.2:8080
# - Simulador iOS ou web no mesmo computador: http://localhost:8080
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
