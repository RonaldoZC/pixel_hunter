# Copie para docker/.env:  cp .env.example .env   (no Windows: copy .env.example .env)
# Os valores abaixo servem para DEMONSTRAÇÃO/DESENVOLVIMENTO e já funcionam. Em produção troque todos
# e NUNCA commite o .env com valores reais.

# Segredo do JWT (mínimo 32 caracteres)
JWT_SECRET=pixel-hunter-demo-jwt-secret-troque-em-producao-0123456789

# Banco de dados (os 4 PostgreSQL usam o mesmo usuário/senha).
# ATENÇÃO: o PostgreSQL só aplica a senha na primeira criação do volume. Se já subiu o ambiente antes,
# use a mesma senha de antes ou apague os volumes (perde os dados): docker compose down -v
DB_USER=postgres
DB_PASSWORD=postgres

# Senha do usuário "admin" do Grafana (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=admin

# Cloudflare R2 (media-api) - OPCIONAL. Sem isto tudo funciona, só o upload de imagens falha.
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
