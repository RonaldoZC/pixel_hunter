# Copie para docker/.env (ignorado pelo git) e preencha. NUNCA commite valores reais.

# Segredo do JWT: mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=

# Banco de dados (os 4 PostgreSQL usam o mesmo usuário/senha).
# ATENÇÃO: o PostgreSQL só aplica a senha na primeira criação do volume. Se já subiu o ambiente antes,
# use a mesma senha de antes ou apague os volumes (perde os dados): docker compose down -v
DB_USER=
DB_PASSWORD=

# Senha do usuário "admin" do Grafana (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=

# Cloudflare R2 (media-api)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
